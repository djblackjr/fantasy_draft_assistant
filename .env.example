# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — your cookies never get committed.

# --- Required for a real (non-demo) ESPN league ---

# Your ESPN Fantasy Football league ID. Find it in the URL when viewing your
# league on espn.com, e.g. https://fantasy.espn.com/football/team?leagueId=123456 -> 123456
ESPN_LEAGUE_ID=

# The season/year of the league, e.g. 2026
ESPN_SEASON=2026

# Your team's ID within the league (used for "my team" / "my picks" views).
# Find it the same way as leagueId, in a team URL: .../team?leagueId=...&teamId=3 -> 3
ESPN_TEAM_ID=

# --- Only required for PRIVATE leagues ---
# ESPN's API needs two cookies from a logged-in browser session to read a
# private league. To get them:
#   1. Log in to fantasy.espn.com in Chrome/Firefox and open your league.
#   2. Open DevTools -> Application (Chrome) or Storage (Firefox) -> Cookies
#      -> https://fantasy.espn.com
#   3. Copy the values of the "espn_s2" and "SWID" cookies below.
# These act like a login session — treat them as secrets. They typically
# expire after some weeks/months, so you may need to refresh them later.
ESPN_S2=
ESPN_SWID=

# Leave the above blank to run the app in DEMO mode with fixture data
# (no real ESPN league needed) — useful for trying the app out first.
